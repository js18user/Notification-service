{
  "id": null,
  "title": "FastAPI Auto Dashboard",
  "style": "dark",
  "timezone": "browser",
  "editable": true,
  "panels": [
    {
      "type": "timeseries",
      "title": "Количество запросов в секунду (RPS)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(http_requests_total[5m]))",
          "refId": "A"
        }
      ]
    }
    {
      "type": "timeseries",
      "title": "Длительность обработки запросов",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
