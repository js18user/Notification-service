def memory_dict(f):
    """ Memoization decorator for a function that takes one argument """

    class ms(dict):
        def __missing__(self, key):
            ret = self[key] = f(key)
            return ret
    return ms().__getitem__


class D(dict):
    def __getattr__(self, n):
        try:
            return self[n]
        except KeyError:
            raise AttributeError(n)

    def __setattr__(self, n, val):
        self[n] = val


