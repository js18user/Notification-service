{
  "id": null,
  "title": "PostgreSQL Database Monitor",
  "style": "dark",
  "timezone": "browser",
  "editable": true,
  "refresh": "3600s",
  "panels": [
    {
      "type": "stat",
      "title": " Active connections",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "textMode": "value", "colorMode": "value", "graphMode": "area", "justifyMode": "center" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "sum(pg_stat_activity_count{datname=\"neondb\"})", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": " Buffer Cache Hit Rate",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 3,
      "options": { "textMode": "value", "colorMode": "value", "graphMode": "area", "justifyMode": "center" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, 
        "expr": "100 * (sum(pg_stat_database_blks_hit{datname=\"neondb\"}) / clamp_min(sum(pg_stat_database_blks_hit{datname=\"neondb\"}) + sum(pg_stat_database_blks_read{datname=\"neondb\"}), 1))",
        "refId": "A" }]
    },
    {
      "type": "stat",
      "title": " Transactions Committed",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "id": 2,
      "options": { "textMode": "value", "colorMode": "none", "graphMode": "area", "justifyMode": "center" },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "rate(pg_stat_database_xact_commit{datname=\"neondb\"}[5m])", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": " Transaction Rollbacks",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "textMode": "value", "colorMode": "value", "graphMode": "area", "justifyMode": "center" },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "rate(pg_stat_database_xact_rollback{datname=\"neondb\"}[5m])", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": " Row Operations (Inserts / Updates)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "sum(rate(pg_stat_user_tables_n_tup_ins{datname=\"neondb\"}[5m])) by (relname)", "legendFormat": "Inserts: {{relname}}", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "sum(rate(pg_stat_user_tables_n_tup_upd{datname=\"neondb\"}[5m])) by (relname)", "legendFormat": "Updates: {{relname}}", "refId": "B" }
      ]
    },
    {
      "type": "barchart",
      "title": " Rows Live count by Table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "pg_stat_user_tables_n_live_tup{datname=\"neondb\"}", "legendFormat": "{{relname}}", "refId": "A" }]
    }
  ],
  "schemaVersion": 38,
  "version": 6
}
