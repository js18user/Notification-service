{
  "id": null,
  "title": "PostgreSQL Database Monitor",
  "style": "dark",
  "timezone": "browser",
  "editable": true,
  "panels": [
    {
      "type": "stat",
      "title": "🔌 Active connections (default_db)",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 15 },
              { "color": "red", "value": 30 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(pg_stat_activity_count{datname=\"default_db\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "📊 Transactions Committed (default_db)",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": {
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "rate(pg_stat_database_xact_commit{datname=\"default_db\"}[5m])",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "version": 3
}
