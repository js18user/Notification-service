{
  "id": null,
  "title": "Python App Resource Monitor",
  "style": "dark",
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "💻 CPU load of the application (%)",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "rate(process_cpu_seconds_total[5m]) * 100",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "🧠 RAM consumption (RAM)",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "process_resident_memory_bytes",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "version": 1
}
